{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MiniZinc",
  "scopeName": "source.mzn",
  "patterns": [
    { "include": "#comments" },
    { "include": "#annotations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.percentage.mzn",
          "match": "%.*$"
        },
        {
          "name": "comment.block.mzn",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "entity.name.tag.annotation.mzn",
          "match": "::\\s*[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mzn",
          "match": "\\b(if|then|else|elseif|endif|let|in|solve|satisfy|minimize|maximize|constraint|output|include|annotation|type|function|predicate|test|op)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.mzn",
          "match": "\\b(var|par|int|float|bool|string|set|array|of|list|opt)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.mzn",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.mzn",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mzn",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.mzn",
              "begin": "\\\\\\(",
              "end": "\\)",
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.mzn",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.mzn",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "constant.numeric.hex.mzn",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.octal.mzn",
          "match": "\\b0o[0-7]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.mzn",
          "match": "(<-|->|<->|/\\\\|\\\\/|\\b(not|in|subset|superset|union|diff|symdiff|intersect)\\b)"
        },
        {
          "name": "keyword.operator.comparison.mzn",
          "match": "(=|!=|<|>|<=|>=)"
        },
        {
          "name": "keyword.operator.arithmetic.mzn",
          "match": "(\\+|-|\\*|/|\\b(div|mod)\\b|\\+\\+|\\.\\.)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.mzn",
          "match": "\\b(forall|sum|exists|abs|min|max|assert|trace|show|card|dom|lb|ub|product|concat|join)\\b"
        }
      ]
    }
  }
}
